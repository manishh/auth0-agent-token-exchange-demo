# Copy this file to .env and fill in your values. Never commit .env.

# Tenant domain, no https:// and no trailing slash
AUTH0_DOMAIN=dev-xxxx.us.auth0.com

# Parent Agent application (Applications > Applications > Parent Agent > Settings)
CLIENT_ID=your-parent-agent-client-id
CLIENT_SECRET=your-parent-agent-client-secret

# API identifiers, exactly as entered when the APIs were created
PARENT_API=https://research-agent.example.com
SEARCH_API=https://search-agent.example.com

# Subject token type URI from the Token Exchange Profile
SUBJECT_TOKEN_TYPE=https://research-agent.example.com/parent-token

# Demo-only test user (the demo logs in with the password grant)
TEST_USER=test-user@example.com
TEST_PASSWORD=your-test-user-password
